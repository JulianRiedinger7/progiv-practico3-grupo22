{
  "name": "@cafeteria/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start:test": "tsx src/server.ts",
    "build": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.config.ts --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test:e2e": "playwright test --config playwright.api.config.ts --pass-with-no-tests"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "@types/better-sqlite3": "^7.6.13",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
